# Copy to .env and fill in. Never commit .env.
# Generate keys:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HM_ENC_KEY=
HM_INDEX_KEY=
HM_JWT_SECRET=

# Must stay "ru": personal data is processed only on servers in the Russian Federation.
DATA_REGION=ru
HM_DOMAIN=healthmonitor.example.ru

# First administrator (created on start if absent)
HM_ADMIN_EMAIL=
HM_ADMIN_PASSWORD=
HM_ADMIN_PHONE=

# SMS gateway of a Russian operator (https only). Empty provider = outbox (no real SMS).
HM_SMS_PROVIDER=outbox
HM_SMS_GATEWAY_URL=

# Escalation step for unacknowledged critical alerts, minutes (charter SLA: 15)
HM_ESCALATION_MINUTES=15
HM_TIMEZONE=Europe/Moscow
